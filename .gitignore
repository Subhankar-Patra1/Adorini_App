# OS / Editor junk
.DS_Store
Thumbs.db
# `.vscode/*` rather than `.vscode/`: git will not descend into an
# ignored *directory*, so the negation below only takes effect if the
# directory itself stays un-ignored and its contents are excluded instead.
.vscode/*
# launch.json is shared on purpose — every developer needs the run configs, and
# it holds no machine-specific values (the backend address it reads lives in
# the gitignored Adorini_Frontend/env/local.json).
!.vscode/launch.json
.idea/

# Environment and secrets
.env
.env.local
.env.*.local
*.env
# `*.env` does not catch a suffixed backup like `.env.bak-before-values`, and
# such a file holds the same real credentials the live `.env` does.
.env.*
!.env.example
**/env/local.json
Adorini_Frontend/env/local.json
# Machine- and session-specific backend URLs (e.g. a temporary tunnel address).
**/env/tunnel.json

# Dependencies and Build Outputs
node_modules/
dist/
build/
coverage/
*.log
AI_COWORKER/
AI_COWORKER.zip