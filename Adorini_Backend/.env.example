# Adorini Backend — environment template
# Copy to .env and fill in. The app refuses to boot if any required value is
# missing or malformed (see src/config/env.validation.ts).

# ---- Core ----
NODE_ENV=development
PORT=3000
API_PREFIX=api

# Comma-separated browser origins allowed to call the API. Leave empty for a
# mobile-only client: CORS is a browser mechanism and does not apply to the
# Flutter Android/iOS app. Set it only for Flutter web or an admin panel.
# localhost is always allowed outside production.
# Example: CORS_ALLOWED_ORIGINS=https://admin.adorini.in,https://shop.adorini.in
CORS_ALLOWED_ORIGINS=

# ---- Database (PostgreSQL 18.4) ----
DATABASE_URL=postgresql://user:password@localhost:5432/adorini
DATABASE_SSL=false

# ---- Redis (8.6.2) ----
REDIS_URL=redis://localhost:6379

# ---- Auth ----
# JWT_SECRET must be >= 32 chars. Generate: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
GOOGLE_OAUTH_CLIENT_ID=

# ---- OTP (self-managed; WhatsApp only delivers the code — no SMS fallback) ----
# All optional — these are the defaults.
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_REQUESTS_PER_HOUR=5
# Lifetime of the token issued when Google sign-in still needs a phone.
REGISTRATION_TOKEN_TTL_SECONDS=600

# ---- Meta WhatsApp Business Cloud API (direct REST, no BSP) ----
# Permanent System User token (Business Settings -> System Users) — not the
# 24h temporary token the developer console hands out for quick testing.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Meta app secret — HMACs the X-Hub-Signature-256 header on inbound webhooks.
WHATSAPP_APP_SECRET=
# Arbitrary string you generate and also paste into the Meta dashboard's
# webhook-configuration screen (hub.verify_token). Min 24 chars.
# Generate: openssl rand -hex 32
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0
# Approved Authentication-category template used for OTP delivery.
WHATSAPP_OTP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en

# ---- Cashfree (payments) ----
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=SANDBOX
CASHFREE_WEBHOOK_SECRET=

# ---- Delhivery (logistics) ----
DELHIVERY_API_TOKEN=
DELHIVERY_BASE_URL=https://track.delhivery.com

# ---- Inbound Delhivery webhook auth (Delhivery does not sign callbacks) ----
# Secret we generate and register in Delhivery's dashboard, sent back as the
# x-adorini-webhook-token header. Min 24 chars. Generate: openssl rand -hex 24
DELHIVERY_WEBHOOK_TOKEN=

# ---- Cloudflare R2 (media storage) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=adorini-media
R2_PUBLIC_BASE_URL=https://media.example.com

# ---- Business rules (server-authoritative — @GUARD Risk #3) ----
# All monetary values in paise to avoid floating-point money bugs.
FREE_DELIVERY_THRESHOLD_PAISE=300000
# Charged below the threshold. PLACEHOLDER — confirm with the business.
DELIVERY_FEE_PAISE=4900
FIRST_ORDER_DISCOUNT_PERCENT=10
REFERRAL_CREDIT_PAISE=10000

# ---- Scheduled jobs ----
# Hours a COD order may sit unverified before the sweep cancels it and releases stock.
COD_VERIFICATION_TIMEOUT_HOURS=24

# ---- Failed-delivery handling ----
# Hours a buyer has to answer the "still want it?" WhatsApp before auto-cancel.
DELIVERY_RESPONSE_WINDOW_HOURS=24
# Total courier hand-over attempts before the parcel returns to origin.
MAX_DELIVERY_ATTEMPTS=3
# Approved Utility-category WhatsApp template for the failed-delivery prompt.
WHATSAPP_DELIVERY_RETRY_TEMPLATE=adorini_delivery_retry
