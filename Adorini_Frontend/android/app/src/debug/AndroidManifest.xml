<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Android 9 (API 28) blocks plain-HTTP traffic by default, which would
         otherwise make every call to a local `http://…:3000` dev backend fail
         with a bare connection error.

         This is declared in the *debug* manifest on purpose: the merger applies
         it only to debug builds, so release builds keep Android's HTTPS-only
         default rather than inheriting a blanket cleartext exemption.
    -->
    <application
        android:usesCleartextTraffic="true"
        tools:targetApi="28" />
</manifest>
